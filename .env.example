# copy to server/.env.local and fill in. never commit the filled version.

# classic PAT. if most of your contributions are in private repos you need
# `repo` scope, otherwise the graph comes back almost entirely grey.
# check with: gh api graphql -f query='{viewer{contributionsCollection{restrictedContributionsCount}}}'
GITHUB_TOKEN=

# whose graph goes on the screen
GITHUB_LOGIN=

# optional, powers the open-issues panel. format: owner/name
GITHUB_REPO=

# shared with the device. openssl rand -hex 24
# read-only, rotate freely, keep it distinct from every other credential you own.
DEVICE_TOKEN=

# only needed if you wire up github push webhooks
WEBHOOK_SECRET=

# pulse counter storage. without these the counter resets on every cold start
# and will not survive across serverless instances. see AGENTS.md.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# comma separated. public build ships `github`.
ADAPTERS=github
